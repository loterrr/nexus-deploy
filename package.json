{
  "name": "the-archive-local-rag",
  "version": "0.1.0",
  "private": true,
  "main": "main/index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "setup:worker": "cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/",
    "setup:models": "node scripts/download-models.js",
    "prepare": "husky",
    "electron-dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-build": "npm run setup:worker && npm run setup:models && next build",
    "dist": "npm run electron-build && electron-builder"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "electron-serve": "^3.0.1",
    "electron-squirrel-startup": "^1.0.0"
  },
  "devDependencies": {
    "@orama/orama": "^2.1.1",
    "@react-hook/window-size": "^3.1.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.28",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18",
    "@types/uuid": "^9.0.8",
    "@xenova/transformers": "^2.17.2",
    "autoprefixer": "^10.4.23",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "framer-motion": "^11.18.2",
    "husky": "^9.1.7",
    "idb": "^8.0.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.7",
    "lucide-react": "^0.344.0",
    "next": "^14.2.35",
    "pdfjs-dist": "^4.10.38",
    "postcss": "^8.5.6",
    "react": "^18",
    "react-dom": "^18",
    "react-dropzone": "^14.3.8",
    "react-force-graph-2d": "^1.29.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.6",
    "typescript": "5.9.3",
    "uuid": "^9.0.1",
    "wait-on": "^7.2.0"
  }
}